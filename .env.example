# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Supabase Configuration
# Obtain these from your Supabase Project Settings -> API
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Port (defaults to 3000)
PORT=3000

# Server-side Supabase URL (same project as VITE_SUPABASE_URL). Required on Vercel.
SUPABASE_URL="https://your-project.supabase.co"

# Bootstrap owner: the first verified Google sign-in with this email becomes
# `owner` automatically (only while no owner exists). No manual SQL needed.
OWNER_EMAIL="advesapp@gmail.com"
